{
  "manifest_version": 3,
  "name": "PR Brief",
  "version": "0.1.0",
  "description": "Walks a GitHub or Forgejo pull request's files page through the stops of a local brief, and shows the brief above the description. Talks only to the local pr-brief server; posts nothing.",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1:8765/*", "http://localhost:3300/*"],
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*", "http://localhost:3300/*"],
      "js": ["page_common.js", "github_page.js", "forgejo_page.js", "page.js", "source.js", "run_control.js", "focus.js", "tree.js", "diagram.js", "brief_text.js", "brief.js", "content.js"],
      "css": ["focus.css", "tree.css", "diagram.css"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "pr-brief@bkonold.github.io",
      "strict_min_version": "128.0"
    }
  }
}
