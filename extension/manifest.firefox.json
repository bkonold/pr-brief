{
  "manifest_version": 3,
  "name": "PR Brief",
  "version": "0.1.0",
  "description": "Walks a GitHub pull request's files page through the stops of its brief. Reads the brief from the pull request's comment; posts nothing.",
  "permissions": ["storage"],
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["page_common.js", "github_page.js", "page.js", "comment_source.js", "source.js", "focus.js", "tree.js", "diagram.js", "content.js"],
      "css": ["focus.css", "tree.css", "diagram.css"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-brief": {
      "suggested_key": { "default": "Alt+B" },
      "description": "Switch the file pane between the PR Brief and the host's own tree"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "pr-brief@bkonold.github.io",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
