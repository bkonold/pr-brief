{
  "manifest_version": 3,
  "name": "PR Describe Review Focus",
  "version": "0.1.0",
  "description": "Focuses a GitHub or Forgejo pull request's files page on one review chunk from a local pr-describe run, and shows the run's brief above the description. Reads only; posts nothing.",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1:8765/*", "http://localhost:3300/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*", "http://localhost:3300/*"],
      "js": ["page_common.js", "github_page.js", "forgejo_page.js", "page.js", "source.js", "variants.js", "boxes.js", "focus.js", "tree.js", "diagram.js", "brief_text.js", "brief.js", "content.js"],
      "css": ["focus.css", "tree.css", "diagram.css"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
